# CreditWise Backend – Environment Variables
# Copy to .env and fill in your values

# Server
PORT=5000
NODE_ENV=production

# MongoDB Atlas
MONGODB_URI=mongodb+srv://<user>:<password>@cluster0.xxxxx.mongodb.net/creditwise_db

# JWT
JWT_SECRET=your_super_secret_jwt_key
JWT_EXPIRES_IN=7d

# ML Engine (Render URL)
ML_ENGINE_URL=https://loan-approval-platform-1.onrender.com

# Frontend CORS (Vercel URL)
CLIENT_URL=https://loan-approval-platform-frontend-13el78w93.vercel.app

# Email (SMTP)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_app_password
EMAIL_FROM=CreditWise <your_email@gmail.com>
